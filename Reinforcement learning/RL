def calculate_reward(smiles):
    mol = Chem.MolFromSmiles(smiles)

    if mol is None:
        return -1.0

    if any(mol.HasSubstructMatch(p) for p in alert_patterns):
        return -1.0

    fingerprint = AllChem.GetMorganFingerprintAsBitVect(
        mol, radius=2, nBits=2048
    )

    similarity = max(
        DataStructs.TanimotoSimilarity(fingerprint, ref)
        for ref in reference_fingerprints
    )

    return 1.0 + similarity
